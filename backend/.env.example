# PostgreSQL Database Connection (Required in production)
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Signal Processing
SIGNAL_PROCESSOR_INTERVAL=300  # seconds
NUM_TOP_SIGNALS=50

# External APIs
ALPHA_VANTAGE_API_KEY=demo
POLYGON_IO_API_KEY=your-key-here
TRADINGVIEW_WEBHOOK_SECRET=your-webhook-secret

# Paper Trading
INITIAL_PAPER_BALANCE=100000
PAPER_TRADING_SLIPPAGE=0.001  # 0.1%

# Risk Management
MAX_POSITION_SIZE_PCT=0.02  # 2% of balance
MAX_PORTFOLIO_EXPOSURE_PCT=0.20  # 20% per asset
MAX_LEVERAGE=5
LIQUIDATION_BUFFER_PCT=0.20  # 20% buffer

# Logging
LOG_LEVEL=INFO

# Security Hardening
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60

# Admin access (comma-separated Firebase UIDs permitted to call admin-only
# endpoints, e.g. KYC approve/reject). Required in production — admin routes
# fail closed (403) if this is empty. Bootstrap mechanism until a proper
# role-based access system exists.
ADMIN_UIDS=
RATE_LIMIT_MAX_REQUESTS=120
SECURITY_HEADERS_ENABLED=true
TRADINGVIEW_WEBHOOK_HMAC_SECRET=your-hmac-secret

# Authentication (Dev Mode)
# Set to true ONLY for local development to skip Firebase token verification.
# NEVER set this to true in production — auth will be enforced regardless.
ALLOW_UNAUTHENTICATED_DEV=false

# Database Runtime Safety
ALLOW_MOCK_DB_FALLBACK=true
REQUIRE_REAL_DB=false
REQUIRED_DB_TABLES=users,signals,paper_trades,positions,portfolios,creator_profiles,kyc_verifications,audit_logs,external_signals,api_keys,strategies,creator_strategies,strategy_subscriptions,strategy_paper_trades,backtests,chat_messages,notifications,user_risk_settings,external_signal_rules

# Feature Flags
FEATURE_BACKTESTING=true
FEATURE_LIVE_TRADING=true
FEATURE_KYC=true
FEATURE_MOBILE_APP=true
FEATURE_COMMUNITY=true
FEATURE_AI_SIGNALS=true
FEATURE_REGULATORY=true

# ============================================================================
# LLM INTEGRATION (Advanced AI Signal Generation)
# ============================================================================
LLM_PROVIDER=openai  # openai, anthropic, google
OPENAI_API_KEY=sk-placeholder-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-placeholder-your-anthropic-key-here
GOOGLE_GENKIT_API_KEY=placeholder-google-genkit-key-here
LLM_MODEL=gpt-4-turbo  # gpt-4-turbo, claude-opus-4, gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================================================
# LIVE TRADING INTEGRATION (Exchange APIs)
# ============================================================================
# Binance
BINANCE_API_KEY=placeholder-binance-api-key-here
BINANCE_SECRET_KEY=placeholder-binance-secret-key-here
BINANCE_TESTNET_ENABLED=true  # Use testnet for development

# Bybit
BYBIT_API_KEY=placeholder-bybit-api-key-here
BYBIT_SECRET_KEY=placeholder-bybit-secret-key-here
BYBIT_TESTNET_ENABLED=true

# OKX
OKX_API_KEY=placeholder-okx-api-key-here
OKX_SECRET_KEY=placeholder-okx-secret-key-here
OKX_PASSPHRASE=placeholder-okx-passphrase-here
OKX_TESTNET_ENABLED=true

# Kraken
KRAKEN_API_KEY=placeholder-kraken-api-key-here
KRAKEN_PRIVATE_KEY=placeholder-kraken-private-key-here
KRAKEN_TESTNET_ENABLED=true

# Live Trading Settings
LIVE_TRADING_ENABLED=false  # Disable until production-ready
LIVE_TRADING_MAX_POSITION_SIZE=1000  # USD
LIVE_TRADING_AUTO_EXECUTION=false
LIVE_TRADING_LOG_LEVEL=verbose

# ============================================================================
# MOBILE APP CONFIGURATION
# ============================================================================
MOBILE_APP_ENABLED=true
MOBILE_APP_API_BASE_URL=https://api.alphaforge.app
MOBILE_APP_WS_URL=wss://api.alphaforge.app/ws
MOBILE_APP_BUILD_NUMBER=1
MOBILE_APP_VERSION=1.0.0
APPLE_APP_ID=placeholder-apple-app-id
GOOGLE_PLAY_PACKAGE_ID=com.alphaforge.trading
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=placeholder-firebase-project-id
FIREBASE_API_KEY=placeholder-firebase-api-key
FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
FIREBASE_STORAGE_BUCKET=placeholder.appspot.com
FIREBASE_MESSAGING_SENDER_ID=placeholder-sender-id
FIREBASE_APP_ID=placeholder-firebase-app-id
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ============================================================================
# SOCIAL & COMMUNITY FEATURES
# ============================================================================
COMMUNITY_ENABLED=true
ENABLE_USER_PROFILES=true
ENABLE_STRATEGY_COMMENTS=true
ENABLE_SIGNAL_RATINGS=true
ENABLE_LEADERBOARDS=true
ENABLE_ACHIEVEMENTS=true
ENABLE_NOTIFICATIONS=true
ENABLE_REAL_TIME_CHAT=true

# Notification Services
SENDGRID_API_KEY=placeholder-sendgrid-api-key-here
TWILIO_ACCOUNT_SID=placeholder-twilio-account-sid-here
TWILIO_AUTH_TOKEN=placeholder-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# ADVANCED SIGNAL FEATURES
# ============================================================================
ENABLE_MULTI_TIMEFRAME_SIGNALS=true
ENABLE_CORRELATION_BASED_SIGNALS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_NEWS_DRIVEN_SIGNALS=true
ENABLE_ML_SIGNAL_RETRAINING=true
ML_RETRAINING_INTERVAL=86400  # seconds (1 day)

# ============================================================================
# REGULATORY & COMPLIANCE
# ============================================================================
REGULATORY_ENABLED=true
ENABLE_COMPLIANCE_CHECKS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_BLOCKCHAIN_PROOFS=true
COMPLIANCE_JURISDICTION=us  # us, eu, global
KYC_PROVIDER=placeholder-kyc-provider  # stripe-verify, trulioo, sum-and-substance
KYC_PROVIDER_API_KEY=placeholder-kyc-api-key-here
AML_CHECK_ENABLED=true
SANCTIONS_LIST_API=placeholder-sanctions-list-api-url

# Disclaimer & Terms
DISCLAIMER_VERSION=1.0
REQUIRES_FINANCIAL_ADVISOR_LICENSE=false
DISCLAIMER_ACCEPT_REQUIRED=true

# ============================================================================
# MARKETPLACE & PAYMENTS
# ============================================================================
ENABLE_MARKETPLACE_PAYMENTS=true
STRIPE_API_KEY=sk_placeholder_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# Subscription tier Stripe Price IDs (create these as recurring Prices in the
# Stripe Dashboard first — checkout fails closed if unset). PRD §16 tiers:
STRIPE_PRICE_BASIC=price_placeholder_basic_39usd_monthly
STRIPE_PRICE_PRO=price_placeholder_pro_99usd_monthly
STRIPE_PRICE_VIP=price_placeholder_vip_199usd_monthly
MARKETPLACE_COMMISSION_PCT=30  # 30% cut on strategy subscriptions
MARKETPLACE_MIN_PAYOUT=100  # USD

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
SENTRY_DSN=placeholder-sentry-dsn-url
POSTHOG_API_KEY=placeholder-posthog-api-key
POSTHOG_PROJECT_ID=placeholder-posthog-project-id
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================
MOCK_EXCHANGE_RESPONSES=true  # For testing without real API calls
MOCK_LLM_RESPONSES=false  # For testing without hitting LLM API
ENABLE_DEBUG_ENDPOINTS=true
DEBUG_USER_ID=debug-user-123

# ============================================================================
# NOTIFICATION SERVICE (§15) - Web Push, Telegram, Discord, Email
# ============================================================================
WEB_PUSH_ENABLED=true
TELEGRAM_ENABLED=true
DISCORD_ENABLED=true
EMAIL_ENABLED=true
TELEGRAM_BOT_TOKEN=placeholder-telegram-bot-token-here
DISCORD_WEBHOOK_URL=placeholder-discord-webhook-url-here
VAPID_PRIVATE_KEY=placeholder-vapid-private-key-here
VAPID_PUBLIC_KEY=placeholder-vapid-public-key-here
VAPID_CLAIMS_SUB=mailto:admin@alphaforge.io

# ============================================================================
# DATA VALIDATION SERVICE (§7.2)
# ============================================================================
FEATURE_DATA_VALIDATION=true
DEDUP_WINDOW_SECONDS=60
OUTLIER_STD_THRESHOLD=5.0
ROLLING_PERIOD=100
CLOCK_SKEW_MS=500.0
CROSS_VENUE_DIVERGENCE_PCT=0.5

# ============================================================================
# BACKUP MARKET DATA PROVIDERS (§7.1) - Polygon, CoinAPI, Kaiko
# ============================================================================
COINAPI_KEY=placeholder-coinapi-key-here
KAIKO_API_KEY=placeholder-kaiko-key-here

# ============================================================================
# AUDIT LOG SERVICE (§28)
# ============================================================================
AUDIT_RETENTION_MONTHS=24
AUDIT_DAILY_VERIFICATION=true

# ============================================================================
# STRATEGY MARKETPLACE (§26.2)
# ============================================================================
MARKETPLACE_VERIFICATION_TOLERANCE=0.05
MARKETPLACE_PAPER_TRADING_WEEKS=4

# ============================================================================
# NEW FEATURE FLAGS
# ============================================================================
FEATURE_NOTIFICATIONS=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_STRATEGY_MARKETPLACE=true
