# AlphaForge root environment template
# Copy to `.env` for docker-compose, or to `.env.local` for Next.js local development.

# Frontend -> Backend API base URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Docker Compose Service Credentials
# These are used by docker-compose.yml — set them in a root .env file
# that is NOT committed to version control.
# ============================================================================

# PostgreSQL
POSTGRES_USER=alphaforge
POSTGRES_PASSWORD=change-me-in-production

# ClickHouse
CLICKHOUSE_USER=alphaforge
CLICKHOUSE_PASSWORD=change-me-in-production

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# Backend runtime variables live in:
# backend/.env.example
